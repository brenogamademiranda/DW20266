{"ast":null,"code":"export default {\n  name: \"DetalheDeputadoComponent\",\n  props: {\n    id: String\n  },\n  data() {\n    return {\n      deputado: null,\n      carregando: true,\n      erro: false\n    };\n  },\n  computed: {\n    status() {\n      return this.deputado && this.deputado.ultimoStatus || {};\n    },\n    gabinete() {\n      return this.status.gabinete || {};\n    },\n    redesSociais() {\n      return this.deputado && this.deputado.redeSocial || [];\n    }\n  },\n  mounted() {\n    this.buscarDetalhes();\n  },\n  methods: {\n    async buscarDetalhes() {\n      try {\n        const url = `https://dadosabertos.camara.leg.br/api/v2/deputados/${this.id}`;\n        const resposta = await fetch(url);\n        const json = await resposta.json();\n        this.deputado = json.dados;\n      } catch (error) {\n        console.error(\"Erro ao buscar detalhes: \", error);\n        this.erro = true;\n      } finally {\n        this.carregando = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","props","id","String","data","deputado","carregando","erro","computed","status","ultimoStatus","gabinete","redesSociais","redeSocial","mounted","buscarDetalhes","methods","url","resposta","fetch","json","dados","error","console"],"sources":["C:\\Users\\breno\\Documents\\DW2026\\DW2026\\Professor\\Aulas\\site-eleitoral\\src\\components\\DetalheDeputadoComponent.vue"],"sourcesContent":["<template>\n  <div class=\"container py-5\">\n    <router-link to=\"/\" class=\"btn btn-outline-secondary mb-4\">\n      &larr; Voltar\n    </router-link>\n\n    <div v-if=\"carregando\" class=\"text-center\">\n      <div class=\"spinner-border\">\n        <span class=\"visually-hidden\">Carregando</span>\n      </div>\n    </div>\n\n    <div v-else-if=\"erro\" class=\"alert alert-danger\">\n      Não foi possível carregar os dados do deputado.\n    </div>\n\n    <div v-else class=\"card shadow-sm\">\n      <div class=\"card-body p-4\">\n        <div class=\"row align-items-center mb-4\">\n          <div class=\"col-md-3 text-center mb-3 mb-md-0\">\n            <img\n              class=\"foto rounded-circle\"\n              :src=\"status.urlFoto\"\n              :alt=\"status.nome\"\n            />\n          </div>\n          <div class=\"col-md-9\">\n            <h2 class=\"mb-1\">{{ status.nome }}</h2>\n            <p class=\"text-muted mb-0\">\n              {{ status.siglaPartido }} - {{ status.siglaUf }}\n            </p>\n          </div>\n        </div>\n\n        <h5>Contato</h5>\n        <ul class=\"list-unstyled mb-4\">\n          <li>\n            <strong>E-mail:</strong>\n            {{ status.email || gabinete.email || \"Não informado\" }}\n          </li>\n          <li>\n            <strong>Telefone do gabinete:</strong>\n            {{ gabinete.telefone || \"Não informado\" }}\n          </li>\n          <li>\n            <strong>Gabinete:</strong>\n            <span v-if=\"gabinete.predio || gabinete.sala\">\n              Prédio {{ gabinete.predio }}, sala {{ gabinete.sala }}, andar\n              {{ gabinete.andar }}\n            </span>\n            <span v-else>Não informado</span>\n          </li>\n        </ul>\n\n        <h5>Redes sociais</h5>\n        <ul v-if=\"redesSociais.length > 0\" class=\"list-unstyled\">\n          <li v-for=\"rede in redesSociais\" :key=\"rede\">\n            <a :href=\"rede\" target=\"_blank\" rel=\"noopener\">{{ rede }}</a>\n          </li>\n        </ul>\n        <p v-else class=\"text-muted\">Nenhuma rede social informada.</p>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"DetalheDeputadoComponent\",\n  props: {\n    id: String,\n  },\n  data() {\n    return {\n      deputado: null,\n      carregando: true,\n      erro: false,\n    };\n  },\n  computed: {\n    status() {\n      return (this.deputado && this.deputado.ultimoStatus) || {};\n    },\n    gabinete() {\n      return this.status.gabinete || {};\n    },\n    redesSociais() {\n      return (this.deputado && this.deputado.redeSocial) || [];\n    },\n  },\n  mounted() {\n    this.buscarDetalhes();\n  },\n  methods: {\n    async buscarDetalhes() {\n      try {\n        const url = `https://dadosabertos.camara.leg.br/api/v2/deputados/${this.id}`;\n        const resposta = await fetch(url);\n        const json = await resposta.json();\n        this.deputado = json.dados;\n      } catch (error) {\n        console.error(\"Erro ao buscar detalhes: \", error);\n        this.erro = true;\n      } finally {\n        this.carregando = false;\n      }\n    },\n  },\n};\n</script>\n\n<style scoped>\n.foto {\n  width: 160px;\n  height: 160px;\n  object-fit: cover;\n}\n</style>\r\n"],"mappings":"AAmEA,eAAe;EACbA,IAAI,EAAE,0BAA0B;EAChCC,KAAK,EAAE;IACLC,EAAE,EAAEC;EACN,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,IAAI;MACdC,UAAU,EAAE,IAAI;MAChBC,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,MAAMA,CAAA,EAAG;MACP,OAAQ,IAAI,CAACJ,QAAO,IAAK,IAAI,CAACA,QAAQ,CAACK,YAAY,IAAK,CAAC,CAAC;IAC5D,CAAC;IACDC,QAAQA,CAAA,EAAG;MACT,OAAO,IAAI,CAACF,MAAM,CAACE,QAAO,IAAK,CAAC,CAAC;IACnC,CAAC;IACDC,YAAYA,CAAA,EAAG;MACb,OAAQ,IAAI,CAACP,QAAO,IAAK,IAAI,CAACA,QAAQ,CAACQ,UAAU,IAAK,EAAE;IAC1D;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,cAAc,CAAC,CAAC;EACvB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,cAAcA,CAAA,EAAG;MACrB,IAAI;QACF,MAAME,GAAE,GAAI,uDAAuD,IAAI,CAACf,EAAE,EAAE;QAC5E,MAAMgB,QAAO,GAAI,MAAMC,KAAK,CAACF,GAAG,CAAC;QACjC,MAAMG,IAAG,GAAI,MAAMF,QAAQ,CAACE,IAAI,CAAC,CAAC;QAClC,IAAI,CAACf,QAAO,GAAIe,IAAI,CAACC,KAAK;MAC5B,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,2BAA2B,EAAEA,KAAK,CAAC;QACjD,IAAI,CAACf,IAAG,GAAI,IAAI;MAClB,UAAU;QACR,IAAI,CAACD,UAAS,GAAI,KAAK;MACzB;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}