{"ast":null,"code":"import CardDeputado from \"./CardDeputado.vue\";\nimport DetalheDeputadoComponent from \"./DetalheDeputadoComponent.vue\";\nexport default {\n  name: \"ListaDeputadosComponent\",\n  components: {\n    CardDeputado,\n    DetalheDeputadoComponent\n  },\n  data() {\n    return {\n      deputados: [],\n      idSelecionado: null,\n      carregando: true,\n      termoBusca: \"\"\n    };\n  },\n  mounted() {\n    this.buscarDeputados();\n  },\n  methods: {\n    async buscarDeputados() {\n      try {\n        this.carregando = true;\n        let url = \"https://dadosabertos.camara.leg.br/api/v2/deputados?ordem=ASC&ordenarPor=nome&itens=100\";\n        if (this.termoBusca.trim() !== \"\") {\n          url += `&nome=${this.termoBusca.trim()}`;\n        }\n        const resposta = await fetch(url);\n        const json = await resposta.json();\n        this.deputados = json.dados;\n        this.carregando = false;\n      } catch (error) {\n        console.error(\"Erro na API de deputados: \", error);\n        this.carregando = false;\n      }\n    },\n    lidarComSelecao(idRecebido) {\n      this.idSelecionado = idRecebido;\n    },\n    voltarParaLista() {\n      this.idSelecionado = null;\n    }\n  }\n};","map":{"version":3,"names":["CardDeputado","DetalheDeputadoComponent","name","components","data","deputados","idSelecionado","carregando","termoBusca","mounted","buscarDeputados","methods","url","trim","resposta","fetch","json","dados","error","console","lidarComSelecao","idRecebido","voltarParaLista"],"sources":["C:\\Users\\breno\\Documents\\DW2026\\DW2026\\Professor\\Aulas\\site-eleitoral\\src\\App.vue"],"sourcesContent":["<template>\n  <div>\n    <div v-show=\"idSelecionado === null\" class=\"container py-5\">\n      <h1 class=\"text-center mb-2 fw-bold titulo\">Lista de Deputados</h1>\n      <p class=\"text-center text-muted mb-4\">\n        Clique em um card para ver os detalhes\n      </p>\n\n      <div class=\"d-flex justify-content-center gap-2 mb-5\">\n        <input\n          class=\"campo-busca\"\n          type=\"text\"\n          placeholder=\"Buscar deputado por nome...\"\n          :value=\"termoBusca\"\n          @input=\"termoBusca = $event.target.value\"\n        />\n        <button class=\"btn btn-primary\" @click=\"buscarDeputados()\">\n          Buscar\n        </button>\n      </div>\n\n      <div v-if=\"carregando\" class=\"text-center\">\n        <div class=\"spinner-border\">\n          <span class=\"visually-hidden\">Carregando</span>\n        </div>\n      </div>\n\n      <div v-else-if=\"deputados.length === 0\" class=\"text-center text-muted\">\n        Nenhum deputado encontrado.\n      </div>\n\n      <div v-else class=\"row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4\">\n        <div class=\"col\" v-for=\"deputado in deputados\" :key=\"deputado.id\">\n          <card-deputado\n            :id=\"deputado.id\"\n            :foto=\"deputado.urlFoto\"\n            :nome=\"deputado.nome\"\n            :partido=\"deputado.siglaPartido\"\n            :uf=\"deputado.siglaUf\"\n            @selecionar-deputado=\"lidarComSelecao\"\n          />\n        </div>\n      </div>\n    </div>\n\n    <detalhe-deputado-component\n      v-if=\"idSelecionado !== null\"\n      :id=\"idSelecionado\"\n      @voltar=\"voltarParaLista\"\n    />\n  </div>\n</template>\n\n<script>\nimport CardDeputado from \"./CardDeputado.vue\";\nimport DetalheDeputadoComponent from \"./DetalheDeputadoComponent.vue\";\n\nexport default {\n  name: \"ListaDeputadosComponent\",\n  components: {\n    CardDeputado,\n    DetalheDeputadoComponent,\n  },\n  data() {\n    return {\n      deputados: [],\n      idSelecionado: null,\n      carregando: true,\n      termoBusca: \"\",\n    };\n  },\n  mounted() {\n    this.buscarDeputados();\n  },\n  methods: {\n    async buscarDeputados() {\n      try {\n        this.carregando = true;\n        let url =\n          \"https://dadosabertos.camara.leg.br/api/v2/deputados?ordem=ASC&ordenarPor=nome&itens=100\";\n\n        if (this.termoBusca.trim() !== \"\") {\n          url += `&nome=${this.termoBusca.trim()}`;\n        }\n\n        const resposta = await fetch(url);\n        const json = await resposta.json();\n        this.deputados = json.dados;\n        this.carregando = false;\n      } catch (error) {\n        console.error(\"Erro na API de deputados: \", error);\n        this.carregando = false;\n      }\n    },\n    lidarComSelecao(idRecebido) {\n      this.idSelecionado = idRecebido;\n    },\n    voltarParaLista() {\n      this.idSelecionado = null;\n    },\n  },\n};\n</script>\n\n<style scoped>\n.titulo {\n  color: #1d4e89;\n}\n\n.campo-busca {\n  width: 100%;\n  max-width: 400px;\n  padding: 8px 12px;\n  border: 1px solid #1d4e89;\n  border-radius: 6px;\n}\n</style>"],"mappings":"AAsDA,OAAOA,YAAW,MAAO,oBAAoB;AAC7C,OAAOC,wBAAuB,MAAO,gCAAgC;AAErE,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVH,YAAY;IACZC;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MACbC,aAAa,EAAE,IAAI;MACnBC,UAAU,EAAE,IAAI;MAChBC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,eAAe,CAAC,CAAC;EACxB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,eAAeA,CAAA,EAAG;MACtB,IAAI;QACF,IAAI,CAACH,UAAS,GAAI,IAAI;QACtB,IAAIK,GAAE,GACJ,yFAAyF;QAE3F,IAAI,IAAI,CAACJ,UAAU,CAACK,IAAI,CAAC,MAAM,EAAE,EAAE;UACjCD,GAAE,IAAK,SAAS,IAAI,CAACJ,UAAU,CAACK,IAAI,CAAC,CAAC,EAAE;QAC1C;QAEA,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAACH,GAAG,CAAC;QACjC,MAAMI,IAAG,GAAI,MAAMF,QAAQ,CAACE,IAAI,CAAC,CAAC;QAClC,IAAI,CAACX,SAAQ,GAAIW,IAAI,CAACC,KAAK;QAC3B,IAAI,CAACV,UAAS,GAAI,KAAK;MACzB,EAAE,OAAOW,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,4BAA4B,EAAEA,KAAK,CAAC;QAClD,IAAI,CAACX,UAAS,GAAI,KAAK;MACzB;IACF,CAAC;IACDa,eAAeA,CAACC,UAAU,EAAE;MAC1B,IAAI,CAACf,aAAY,GAAIe,UAAU;IACjC,CAAC;IACDC,eAAeA,CAAA,EAAG;MAChB,IAAI,CAAChB,aAAY,GAAI,IAAI;IAC3B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}