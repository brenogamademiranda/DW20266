{"ast":null,"code":"import CardDeputado from \"./CardDeputado.vue\";\nimport DetalheDeputadoComponent from \"./DetalheDeputadoComponent.vue\";\nexport default {\n  name: \"ListaDeputadosComponent\",\n  components: {\n    CardDeputado,\n    DetalheDeputadoComponent\n  },\n  data() {\n    return {\n      deputados: [],\n      idSelecionado: null,\n      carregando: true,\n      termoBusca: \"\"\n    };\n  },\n  mounted() {\n    this.buscarDeputados();\n  },\n  methods: {\n    async buscarDeputados() {\n      try {\n        this.carregando = true;\n        let url = \"https://dadosabertos.camara.leg.br/api/v2/deputados?ordem=ASC&ordenarPor=nome&itens=100\";\n        if (this.termoBusca !== \"\") {\n          url += `&nome=${this.termoBusca}`;\n        }\n        const resposta = await fetch(url);\n        const json = await resposta.json();\n        this.deputados = json.dados;\n        this.carregando = false;\n      } catch (error) {\n        console.error(\"Erro na API de deputados: \", error);\n        this.carregando = false;\n      }\n    },\n    lidarComSelecao(idRecebido) {\n      this.idSelecionado = idRecebido;\n    },\n    voltarParaLista() {\n      this.idSelecionado = null;\n    }\n  }\n};","map":{"version":3,"names":["CardDeputado","DetalheDeputadoComponent","name","components","data","deputados","idSelecionado","carregando","termoBusca","mounted","buscarDeputados","methods","url","resposta","fetch","json","dados","error","console","lidarComSelecao","idRecebido","voltarParaLista"],"sources":["C:\\Users\\breno\\Documents\\DW2026\\DW2026\\Professor\\Aulas\\site-eleitoral\\src\\components\\ListaDeputadosComponent.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div v-show=\"idSelecionado === null\" class=\"container py-5\">\r\n      <h1 class=\"text-center mb-2 fw-bold titulo\">Lista de Deputados</h1>\r\n      <p class=\"text-center text-muted mb-4\">\r\n        Clique em um card para ver os detalhes\r\n      </p>\r\n\r\n      <div class=\"text-center mb-5\">\r\n        <input\r\n          class=\"campo-busca\"\r\n          type=\"text\"\r\n          placeholder=\"Buscar deputado por nome...\"\r\n          :value=\"termoBusca\"\r\n          @input=\"termoBusca = $event.target.value\"\r\n        />\r\n        <button class=\"btn btn-primary\" @click=\"buscarDeputados()\">\r\n          Buscar\r\n        </button>\r\n      </div>\r\n\r\n      <div v-if=\"carregando\" class=\"text-center\">\r\n        <div class=\"spinner-border\">\r\n          <span class=\"visually-hidden\">Carregando</span>\r\n        </div>\r\n      </div>\r\n\r\n      <div v-else>\r\n        <p v-if=\"deputados.length === 0\" class=\"text-center text-muted\">\r\n          Nenhum deputado encontrado.\r\n        </p>\r\n\r\n        <div class=\"row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4\">\r\n          <div class=\"col\" v-for=\"deputado in deputados\" :key=\"deputado.id\">\r\n            <card-deputado\r\n              :id=\"deputado.id\"\r\n              :foto=\"deputado.urlFoto\"\r\n              :nome=\"deputado.nome\"\r\n              :partido=\"deputado.siglaPartido\"\r\n              :uf=\"deputado.siglaUf\"\r\n              @selecionar-deputado=\"lidarComSelecao\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <detalhe-deputado-component\r\n      v-if=\"idSelecionado !== null\"\r\n      :id=\"idSelecionado\"\r\n      @voltar=\"voltarParaLista\"\r\n    />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport CardDeputado from \"./CardDeputado.vue\";\r\nimport DetalheDeputadoComponent from \"./DetalheDeputadoComponent.vue\";\r\n\r\nexport default {\r\n  name: \"ListaDeputadosComponent\",\r\n  components: {\r\n    CardDeputado,\r\n    DetalheDeputadoComponent,\r\n  },\r\n  data() {\r\n    return {\r\n      deputados: [],\r\n      idSelecionado: null,\r\n      carregando: true,\r\n      termoBusca: \"\",\r\n    };\r\n  },\r\n  mounted() {\r\n    this.buscarDeputados();\r\n  },\r\n  methods: {\r\n    async buscarDeputados() {\r\n      try {\r\n        this.carregando = true;\r\n        let url =\r\n          \"https://dadosabertos.camara.leg.br/api/v2/deputados?ordem=ASC&ordenarPor=nome&itens=100\";\r\n\r\n        if (this.termoBusca !== \"\") {\r\n          url += `&nome=${this.termoBusca}`;\r\n        }\r\n\r\n        const resposta = await fetch(url);\r\n        const json = await resposta.json();\r\n        this.deputados = json.dados;\r\n        this.carregando = false;\r\n      } catch (error) {\r\n        console.error(\"Erro na API de deputados: \", error);\r\n        this.carregando = false;\r\n      }\r\n    },\r\n    lidarComSelecao(idRecebido) {\r\n      this.idSelecionado = idRecebido;\r\n    },\r\n    voltarParaLista() {\r\n      this.idSelecionado = null;\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.titulo {\r\n  color: #1d4e89;\r\n}\r\n\r\n.campo-busca {\r\n  width: 300px;\r\n  margin-right: 8px;\r\n  padding: 8px 12px;\r\n  border: 1px solid #1d4e89;\r\n  border-radius: 6px;\r\n}\r\n</style>"],"mappings":"AAwDA,OAAOA,YAAW,MAAO,oBAAoB;AAC7C,OAAOC,wBAAuB,MAAO,gCAAgC;AAErE,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVH,YAAY;IACZC;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MACbC,aAAa,EAAE,IAAI;MACnBC,UAAU,EAAE,IAAI;MAChBC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,eAAe,CAAC,CAAC;EACxB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,eAAeA,CAAA,EAAG;MACtB,IAAI;QACF,IAAI,CAACH,UAAS,GAAI,IAAI;QACtB,IAAIK,GAAE,GACJ,yFAAyF;QAE3F,IAAI,IAAI,CAACJ,UAAS,KAAM,EAAE,EAAE;UAC1BI,GAAE,IAAK,SAAS,IAAI,CAACJ,UAAU,EAAE;QACnC;QAEA,MAAMK,QAAO,GAAI,MAAMC,KAAK,CAACF,GAAG,CAAC;QACjC,MAAMG,IAAG,GAAI,MAAMF,QAAQ,CAACE,IAAI,CAAC,CAAC;QAClC,IAAI,CAACV,SAAQ,GAAIU,IAAI,CAACC,KAAK;QAC3B,IAAI,CAACT,UAAS,GAAI,KAAK;MACzB,EAAE,OAAOU,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,4BAA4B,EAAEA,KAAK,CAAC;QAClD,IAAI,CAACV,UAAS,GAAI,KAAK;MACzB;IACF,CAAC;IACDY,eAAeA,CAACC,UAAU,EAAE;MAC1B,IAAI,CAACd,aAAY,GAAIc,UAAU;IACjC,CAAC;IACDC,eAAeA,CAAA