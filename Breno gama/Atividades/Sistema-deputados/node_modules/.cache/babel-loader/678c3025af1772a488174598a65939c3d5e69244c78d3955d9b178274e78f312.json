{"ast":null,"code":"export default {\n  name: \"DetalheDeputadoComponent\",\n  emits: [\"voltar\"],\n  props: {\n    id: Number\n  },\n  data() {\n    return {\n      status: {},\n      gabinete: {},\n      redesSociais: [],\n      carregando: true,\n      erro: false\n    };\n  },\n  mounted() {\n    this.buscarDetalhes();\n  },\n  methods: {\n    async buscarDetalhes() {\n      try {\n        this.carregando = true;\n        this.erro = false;\n        const url = `https://dadosabertos.camara.leg.br/api/v2/deputados/${this.id}`;\n        const resposta = await fetch(url);\n        if (!resposta.ok) {\n          throw new Error(\"Status \" + resposta.status);\n        }\n        const json = await resposta.json();\n        this.status = json.dados.ultimoStatus || {};\n        this.gabinete = this.status.gabinete || {};\n        this.redesSociais = json.dados.redeSocial || [];\n        this.carregando = false;\n      } catch (error) {\n        console.error(\"Erro ao buscar detalhes: \", error);\n        this.erro = true;\n        this.carregando = false;\n      }\n    },\n    voltar() {\n      this.$emit(\"voltar\");\n    }\n  }\n};","map":{"version":3,"names":["name","emits","props","id","Number","data","status","gabinete","redesSociais","carregando","erro","mounted","buscarDetalhes","methods","url","resposta","fetch","ok","Error","json","dados","ultimoStatus","redeSocial","error","console","voltar","$emit"],"sources":["C:\\Users\\breno\\Documents\\DW2026\\DW2026\\Professor\\Aulas\\site-eleitoral\\src\\components\\DetalheDeputadoComponent.vue"],"sourcesContent":["<template>\n  <div class=\"container py-5\">\n    <button class=\"btn btn-outline-primary mb-4\" @click=\"voltar()\">\n      &larr; Voltar\n    </button>\n\n    <div v-if=\"carregando\" class=\"text-center\">\n      <div class=\"spinner-border\">\n        <span class=\"visually-hidden\">Carregando</span>\n      </div>\n    </div>\n\n    <div v-else-if=\"erro\" class=\"erro\">\n      <p class=\"mb-3\">Não foi possível carregar os dados do deputado.</p>\n      <button class=\"btn btn-outline-primary\" @click=\"buscarDetalhes()\">\n        Tentar novamente\n      </button>\n    </div>\n\n    <div v-else class=\"card shadow-sm\">\n      <div class=\"card-body\">\n        <div class=\"d-flex align-items-center gap-3 mb-4\">\n          <img\n            class=\"foto rounded-circle\"\n            :src=\"status.urlFoto\"\n            :alt=\"status.nome\"\n          />\n          <div>\n            <h2 class=\"nome\">{{ status.nome }}</h2>\n            <p class=\"partido mb-0\">\n              {{ status.siglaPartido }} - {{ status.siglaUf }}\n            </p>\n          </div>\n        </div>\n\n        <h5 class=\"subtitulo\">Contato</h5>\n        <p class=\"mb-1\">\n          <strong>E-mail:</strong>\n          {{ status.email || gabinete.email || \"Não informado\" }}\n        </p>\n        <p class=\"mb-1\">\n          <strong>Telefone do gabinete:</strong>\n          {{ gabinete.telefone || \"Não informado\" }}\n        </p>\n        <p class=\"mb-4\">\n          <strong>Gabinete:</strong>\n          <span v-if=\"gabinete.predio || gabinete.sala\">\n            Prédio {{ gabinete.predio }}, sala {{ gabinete.sala }}, andar\n            {{ gabinete.andar }}\n          </span>\n          <span v-else>Não informado</span>\n        </p>\n\n        <h5 class=\"subtitulo\">Redes sociais</h5>\n        <div v-if=\"redesSociais.length > 0\">\n          <p class=\"mb-1\" v-for=\"rede in redesSociais\" :key=\"rede\">\n            <a :href=\"rede\" target=\"_blank\">{{ rede }}</a>\n          </p>\n        </div>\n        <p v-else class=\"text-muted\">Nenhuma rede social informada.</p>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"DetalheDeputadoComponent\",\n  emits: [\"voltar\"],\n  props: {\n    id: Number,\n  },\n  data() {\n    return {\n      status: {},\n      gabinete: {},\n      redesSociais: [],\n      carregando: true,\n      erro: false,\n    };\n  },\n  mounted() {\n    this.buscarDetalhes();\n  },\n  methods: {\n    async buscarDetalhes() {\n      try {\n        this.carregando = true;\n        this.erro = false;\n        const url = `https://dadosabertos.camara.leg.br/api/v2/deputados/${this.id}`;\n        const resposta = await fetch(url);\n        if (!resposta.ok) {\n          throw new Error(\"Status \" + resposta.status);\n        }\n        const json = await resposta.json();\n        this.status = json.dados.ultimoStatus || {};\n        this.gabinete = this.status.gabinete || {};\n        this.redesSociais = json.dados.redeSocial || [];\n        this.carregando = false;\n      } catch (error) {\n        console.error(\"Erro ao buscar detalhes: \", error);\n        this.erro = true;\n        this.carregando = false;\n      }\n    },\n    voltar() {\n      this.$emit(\"voltar\");\n    },\n  },\n};\n</script>\n\n<style scoped>\n.foto {\n  width: 160px;\n  height: 160px;\n  object-fit: cover;\n  border: 4px solid #f2b705;\n}\n\n.nome {\n  color: #14365f;\n}\n\n.partido {\n  color: #1d4e89;\n  font-weight: bold;\n}\n\n.subtitulo {\n  display: inline-block;\n  padding-bottom: 4px;\n  color: #14365f;\n  border-bottom: 2px solid #f2b705;\n}\n\n.erro {\n  padding: 16px;\n  color: #842029;\n  background-color: #f8d7da;\n  border-radius: 8px;\n}\n</style>"],"mappings":"AAkEA,eAAe;EACbA,IAAI,EAAE,0BAA0B;EAChCC,KAAK,EAAE,CAAC,QAAQ,CAAC;EACjBC,KAAK,EAAE;IACLC,EAAE,EAAEC;EACN,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,MAAM,EAAE,CAAC,CAAC;MACVC,QAAQ,EAAE,CAAC,CAAC;MACZC,YAAY,EAAE,EAAE;MAChBC,UAAU,EAAE,IAAI;MAChBC,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,cAAc,CAAC,CAAC;EACvB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,cAAcA,CAAA,EAAG;MACrB,IAAI;QACF,IAAI,CAACH,UAAS,GAAI,IAAI;QACtB,IAAI,CAACC,IAAG,GAAI,KAAK;QACjB,MAAMI,GAAE,GAAI,uDAAuD,IAAI,CAACX,EAAE,EAAE;QAC5E,MAAMY,QAAO,GAAI,MAAMC,KAAK,CAACF,GAAG,CAAC;QACjC,IAAI,CAACC,QAAQ,CAACE,EAAE,EAAE;UAChB,MAAM,IAAIC,KAAK,CAAC,SAAQ,GAAIH,QAA