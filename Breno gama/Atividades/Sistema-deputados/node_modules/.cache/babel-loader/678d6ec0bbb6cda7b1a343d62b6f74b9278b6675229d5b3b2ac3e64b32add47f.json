{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport CardDeputado from \"./CardDeputado.vue\";\nexport default {\n  name: \"ListaDeputadosComponent\",\n  components: {\n    CardDeputado\n  },\n  data() {\n    return {\n      deputados: [],\n      idSelecionado: null,\n      carregando: true,\n      termoBusca: \"\"\n    };\n  },\n  computed: {\n    deputadosFiltrados() {\n      const termo = this.termoBusca.trim().toLowerCase();\n      if (!termo) return this.deputados;\n      return this.deputados.filter(deputado => {\n        return deputado.nome.toLowerCase().includes(termo) || deputado.siglaPartido.toLowerCase().includes(termo);\n      });\n    }\n  },\n  mounted() {\n    this.buscarDeputados();\n  },\n  methods: {\n    async buscarDeputados() {\n      try {\n        this.carregando = true;\n        const url = \"https://dadosabertos.camara.leg.br/api/v2/deputados?siglaUf=MG&ordem=ASC&ordenarPor=nome\";\n        const resposta = await fetch(url);\n        const json = await resposta.json();\n        this.deputados = json.dados;\n        this.carregando = false;\n      } catch (error) {\n        console.error(\"Erro na API de deputados: \", error);\n      }\n    },\n    lidarComSelecao(idRecebido) {\n      if (this.idSelecionado === idRecebido) {\n        this.idSelecionado = null;\n      } else {\n        this.idSelecionado = idRecebido;\n      }\n    }\n  }\n};","map":{"version":3,"names":["CardDeputado","name","components","data","deputados","idSelecionado","carregando","termoBusca","computed","deputadosFiltrados","termo","trim","toLowerCase","filter","deputado","nome","includes","siglaPartido","mounted","buscarDeputados","methods","url","resposta","fetch","json","dados","error","console","lidarComSelecao","idRecebido"],"sources":["C:\\Users\\breno\\Documents\\DW2026\\DW2026\\Professor\\Aulas\\site-eleitoral\\src\\components\\ListaDeputadosComponent.vue"],"sourcesContent":["<template>\r\n  <div class=\"container py-5\">\r\n    <h1 class=\"text-center mb-2\">Lista de Deputados</h1>\r\n    <p class=\"text-center text-muted mb-5\">Clique em um card para destacá-lo</p>\r\n\r\n    <div class=\"row justify-content-center mb-5\">\r\n      <div class=\"col-md-6\">\r\n        <input\r\n          v-model=\"termoBusca\"\r\n          type=\"text\"\r\n          class=\"form-control\"\r\n          placeholder=\"Buscar por nome ou partido...\"\r\n        />\r\n      </div>\r\n    </div>\r\n\r\n    <div v-if=\"carregando\" class=\"tex-center\">\r\n      <div class=\"spinner-border\">\r\n        <span class=\"visually-hidden\">Carregando</span>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-else class=\"row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4\">\r\n      <div class=\"col\" v-for=\"deputado in deputadosFiltrados\" :key=\"deputado.id\">\r\n        <card-deputado\r\n          :id=\"deputado.id\"\r\n          :foto=\"deputado.urlFoto\"\r\n          :nome=\"deputado.nome\"\r\n          :partido=\"deputado.siglaPartido\"\r\n          :is-selecionado=\"deputado.id === idSelecionado\"\r\n          @selecionar-deputado=\"lidarComSelecao\"\r\n        />\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport CardDeputado from \"./CardDeputado.vue\";\r\n\r\nexport default {\r\n  name: \"ListaDeputadosComponent\",\r\n  components: {\r\n    CardDeputado,\r\n  },\r\n  data() {\r\n    return {\r\n      deputados: [],\r\n      idSelecionado: null,\r\n      carregando: true,\r\n      termoBusca: \"\",\r\n    };\r\n  },\r\n  computed: {\r\n    deputadosFiltrados() {\r\n      const termo = this.termoBusca.trim().toLowerCase();\r\n      if (!termo) return this.deputados;\r\n\r\n      return this.deputados.filter((deputado) => {\r\n        return (\r\n          deputado.nome.toLowerCase().includes(termo) ||\r\n          deputado.siglaPartido.toLowerCase().includes(termo)\r\n        );\r\n      });\r\n    },\r\n  },\r\n  mounted() {\r\n    this.buscarDeputados();\r\n  },\r\n  methods: {\r\n    async buscarDeputados() {\r\n      try {\r\n        this.carregando = true;\r\n        const url =\r\n          \"https://dadosabertos.camara.leg.br/api/v2/deputados?siglaUf=MG&ordem=ASC&ordenarPor=nome\";\r\n\r\n        const resposta = await fetch(url);\r\n        const json = await resposta.json();\r\n        this.deputados = json.dados;\r\n        this.carregando = false;\r\n      } catch (error) {\r\n        console.error(\"Erro na API de deputados: \", error);\r\n      }\r\n    },\r\n    lidarComSelecao(idRecebido) {\r\n      if (this.idSelecionado === idRecebido) {\r\n        this.idSelecionado = null;\r\n      } else {\r\n        this.idSelecionado = idRecebido;\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>"],"mappings":";;;AAsCA,OAAOA,YAAW,MAAO,oBAAoB;AAE7C,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MACbC,aAAa,EAAE,IAAI;MACnBC,UAAU,EAAE,IAAI;MAChBC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACRC,kBAAkBA,CAAA,EAAG;MACnB,MAAMC,KAAI,GAAI,IAAI,CAACH,UAAU,CAACI,IAAI,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC;MAClD,IAAI,CAACF,KAAK,EAAE,OAAO,IAAI,CAACN,SAAS;MAEjC,OAAO,IAAI,CAACA,SAAS,CAACS,MAAM,CAAEC,QAAQ,IAAK;QACzC,OACEA,QAAQ,CAACC,IAAI,CAACH,WAAW,CAAC,CAAC,CAACI,QAAQ,CAACN,KAAK,KAC1CI,QAAQ,CAACG,YAAY,CAACL,WAAW,CAAC,CAAC,CAACI,QAAQ,CAACN,KAAK;MAEtD,CAAC,CAAC;IACJ;EACF,CAAC;EACDQ,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,eAAe,CAAC,CAAC;EACxB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,eAAeA,CAAA,EAAG;MACtB,IAAI;QACF,IAAI,CAACb,UAAS,GAAI,IAAI;QACtB,MAAMe,GAAE,GACN,0FAA0F;QAE5F,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAACF,GAAG,CAAC;QACjC,MAAMG,IAAG,GAAI,MAAMF,QAAQ,CAACE,IAAI,CAAC,CAAC;QAClC,IAAI,CAACpB,SAAQ,GAAIoB,IAAI,CAACC,KAAK;QAC3B,IAAI,CAACnB,UAAS,GAAI,KAAK;MACzB,EAAE,OAAOoB,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,4BAA4B,EAAEA,KAAK,CAAC;MACpD;IACF,CAAC;IACDE,eAAeA,CAACC,UAAU,EAAE;MAC1B,IAAI,IAAI,CAACxB,aAAY,KAAMwB,UAAU,EAAE;QACrC,IAAI