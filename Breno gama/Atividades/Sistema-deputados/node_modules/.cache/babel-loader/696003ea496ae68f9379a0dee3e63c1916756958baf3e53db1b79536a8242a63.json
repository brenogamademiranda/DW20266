{"ast":null,"code":"import CardDeputado from \"./CardDeputado.vue\";\nexport default {\n  name: \"ListaDeputadosComponent\",\n  components: {\n    CardDeputado\n  },\n  emits: [\"selecionar-deputado\"],\n  data() {\n    return {\n      deputados: [],\n      carregando: true,\n      termoBusca: \"\"\n    };\n  },\n  mounted() {\n    this.buscarDeputados();\n  },\n  methods: {\n    async buscarDeputados() {\n      try {\n        this.carregando = true;\n        let url = \"https://dadosabertos.camara.leg.br/api/v2/deputados?ordem=ASC&ordenarPor=nome&itens=100\";\n        if (this.termoBusca.trim() !== \"\") {\n          url += `&nome=${this.termoBusca.trim()}`;\n        }\n        const resposta = await fetch(url);\n        const json = await resposta.json();\n        this.deputados = json.dados;\n        this.carregando = false;\n      } catch (error) {\n        console.error(\"Erro na API de deputados: \", error);\n        this.carregando = false;\n      }\n    },\n    lidarComSelecao(idRecebido) {\n      this.$emit(\"selecionar-deputado\", idRecebido);\n    }\n  }\n};","map":{"version":3,"names":["CardDeputado","name","components","emits","data","deputados","carregando","termoBusca","mounted","buscarDeputados","methods","url","trim","resposta","fetch","json","dados","error","console","lidarComSelecao","idRecebido","$emit"],"sources":["C:\\Users\\breno\\Documents\\DW2026\\DW2026\\Professor\\Aulas\\site-eleitoral\\src\\components\\ListaDeputadosComponent.vue"],"sourcesContent":["<template>\r\n  <div class=\"container py-5\">\r\n    <h1 class=\"text-center mb-2 fw-bold titulo\">Lista de Deputados</h1>\r\n    <p class=\"text-center text-muted mb-4\">\r\n      Clique em um card para ver os detalhes\r\n    </p>\r\n\r\n    <div class=\"d-flex justify-content-center gap-2 mb-5\">\r\n      <input\r\n        class=\"campo-busca\"\r\n        type=\"text\"\r\n        placeholder=\"Buscar deputado por nome...\"\r\n        :value=\"termoBusca\"\r\n        @input=\"termoBusca = $event.target.value\"\r\n      />\r\n      <button class=\"btn btn-primary\" @click=\"buscarDeputados()\">Buscar</button>\r\n    </div>\r\n\r\n    <div v-if=\"carregando\" class=\"text-center\">\r\n      <div class=\"spinner-border\">\r\n        <span class=\"visually-hidden\">Carregando</span>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-else-if=\"deputados.length === 0\" class=\"text-center text-muted\">\r\n      Nenhum deputado encontrado.\r\n    </div>\r\n\r\n    <div v-else class=\"row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4\">\r\n      <div class=\"col\" v-for=\"deputado in deputados\" :key=\"deputado.id\">\r\n        <card-deputado\r\n          :id=\"deputado.id\"\r\n          :foto=\"deputado.urlFoto\"\r\n          :nome=\"deputado.nome\"\r\n          :partido=\"deputado.siglaPartido\"\r\n          :uf=\"deputado.siglaUf\"\r\n          @selecionar-deputado=\"lidarComSelecao\"\r\n        />\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport CardDeputado from \"./CardDeputado.vue\";\r\n\r\nexport default {\r\n  name: \"ListaDeputadosComponent\",\r\n  components: {\r\n    CardDeputado,\r\n  },\r\n  emits: [\"selecionar-deputado\"],\r\n  data() {\r\n    return {\r\n      deputados: [],\r\n      carregando: true,\r\n      termoBusca: \"\",\r\n    };\r\n  },\r\n  mounted() {\r\n    this.buscarDeputados();\r\n  },\r\n  methods: {\r\n    async buscarDeputados() {\r\n      try {\r\n        this.carregando = true;\r\n        let url =\r\n          \"https://dadosabertos.camara.leg.br/api/v2/deputados?ordem=ASC&ordenarPor=nome&itens=100\";\r\n\r\n        if (this.termoBusca.trim() !== \"\") {\r\n          url += `&nome=${this.termoBusca.trim()}`;\r\n        }\r\n\r\n        const resposta = await fetch(url);\r\n        const json = await resposta.json();\r\n        this.deputados = json.dados;\r\n        this.carregando = false;\r\n      } catch (error) {\r\n        console.error(\"Erro na API de deputados: \", error);\r\n        this.carregando = false;\r\n      }\r\n    },\r\n    lidarComSelecao(idRecebido) {\r\n      this.$emit(\"selecionar-deputado\", idRecebido);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.titulo {\r\n  color: #1d4e89;\r\n}\r\n\r\n.campo-busca {\r\n  width: 100%;\r\n  max-width: 400px;\r\n  padding: 8px 12px;\r\n  border: 1px solid #1d4e89;\r\n  border-radius: 6px;\r\n}\r\n</style>"],"mappings":"AA4CA,OAAOA,YAAW,MAAO,oBAAoB;AAE7C,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAK,EAAE,CAAC,qBAAqB,CAAC;EAC9BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MACbC,UAAU,EAAE,IAAI;MAChBC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,eAAe,CAAC,CAAC;EACxB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,eAAeA,CAAA,EAAG;MACtB,IAAI;QACF,IAAI,CAACH,UAAS,GAAI,IAAI;QACtB,IAAIK,GAAE,GACJ,yFAAyF;QAE3F,IAAI,IAAI,CAACJ,UAAU,CAACK,IAAI,CAAC,MAAM,EAAE,EAAE;UACjCD,GAAE,IAAK,SAAS,IAAI,CAACJ,UAAU,CAACK,IAAI,CAAC,CAAC,EAAE;QAC1C;QAEA,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAACH,GAAG,CAAC;QACjC,MAAMI,IAAG,GAAI,MAAMF,QAAQ,CAACE,IAAI,CAAC,CAAC;QAClC,IAAI,CAACV,SAAQ,GAAIU,IAAI,CAACC,KAAK;QAC3B,IAAI,CAACV,UAAS,GAAI,KAAK;MACzB,EAAE,OAAOW,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,4BAA4B,EAAEA,KAAK,CAAC;QAClD,IAAI,CAACX,UAAS,GAAI,KAAK;MACzB;IACF,CAAC;IACDa,eAAeA,CAACC,UAAU,EAAE;MAC1B,IAAI,CAACC,KAAK,CAAC,qBAAqB,EAAED,UAAU,CAAC;IAC/C;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}