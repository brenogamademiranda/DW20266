{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport CardDeputado from \"./CardDeputado.vue\";\nexport default {\n  name: \"ListaDeputadosComponent\",\n  components: {\n    CardDeputado\n  },\n  data() {\n    return {\n      deputados: [],\n      carregando: true,\n      termoBusca: \"\",\n      temporizador: null,\n      contadorBusca: 0\n    };\n  },\n  watch: {\n    termoBusca() {\n      clearTimeout(this.temporizador);\n      this.temporizador = setTimeout(() => {\n        this.buscarDeputados();\n      }, 400);\n    }\n  },\n  mounted() {\n    this.buscarDeputados();\n  },\n  beforeUnmount() {\n    clearTimeout(this.temporizador);\n  },\n  methods: {\n    async buscarDeputados() {\n      const numeroDestaBusca = ++this.contadorBusca;\n      try {\n        this.carregando = true;\n        let url = \"https://dadosabertos.camara.leg.br/api/v2/deputados?ordem=ASC&ordenarPor=nome&itens=100\";\n        const termo = this.termoBusca.trim();\n        if (termo) {\n          url += `&nome=${encodeURIComponent(termo)}`;\n        }\n        const resposta = await fetch(url);\n        const json = await resposta.json();\n        if (numeroDestaBusca !== this.contadorBusca) return;\n        this.deputados = json.dados;\n      } catch (error) {\n        console.error(\"Erro na API de deputados: \", error);\n        if (numeroDestaBusca === this.contadorBusca) {\n          this.deputados = [];\n        }\n      } finally {\n        if (numeroDestaBusca === this.contadorBusca) {\n          this.carregando = false;\n        }\n      }\n    },\n    abrirDetalhes(idRecebido) {\n      this.$router.push({\n        name: \"detalhe\",\n        params: {\n          id: idRecebido\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["CardDeputado","name","components","data","deputados","carregando","termoBusca","temporizador","contadorBusca","watch","clearTimeout","setTimeout","buscarDeputados","mounted","beforeUnmount","methods","numeroDestaBusca","url","termo","trim","encodeURIComponent","resposta","fetch","json","dados","error","console","abrirDetalhes","idRecebido","$router","push","params","id"],"sources":["C:\\Users\\breno\\Documents\\DW2026\\DW2026\\Professor\\Aulas\\site-eleitoral\\src\\components\\ListaDeputadosComponent.vue"],"sourcesContent":["<template>\r\n  <div class=\"container py-5\">\r\n    <h1 class=\"text-center mb-2\">Lista de Deputados</h1>\r\n    <p class=\"text-center text-muted mb-5\">\r\n      Clique em um card para ver os detalhes\r\n    </p>\r\n\r\n    <div class=\"row justify-content-center mb-5\">\r\n      <div class=\"col-md-6\">\r\n        <input\r\n          v-model=\"termoBusca\"\r\n          type=\"text\"\r\n          class=\"form-control\"\r\n          placeholder=\"Buscar deputado por nome...\"\r\n        />\r\n      </div>\r\n    </div>\r\n\r\n    <div v-if=\"carregando\" class=\"text-center\">\r\n      <div class=\"spinner-border\">\r\n        <span class=\"visually-hidden\">Carregando</span>\r\n      </div>\r\n    </div>\r\n\r\n    <div v-else-if=\"deputados.length === 0\" class=\"text-center text-muted\">\r\n      Nenhum deputado encontrado.\r\n    </div>\r\n\r\n    <div v-else class=\"row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4\">\r\n      <div class=\"col\" v-for=\"deputado in deputados\" :key=\"deputado.id\">\r\n        <card-deputado\r\n          :id=\"deputado.id\"\r\n          :foto=\"deputado.urlFoto\"\r\n          :nome=\"deputado.nome\"\r\n          :partido=\"deputado.siglaPartido\"\r\n          :uf=\"deputado.siglaUf\"\r\n          @selecionar-deputado=\"abrirDetalhes\"\r\n        />\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport CardDeputado from \"./CardDeputado.vue\";\r\n\r\nexport default {\r\n  name: \"ListaDeputadosComponent\",\r\n  components: {\r\n    CardDeputado,\r\n  },\r\n  data() {\r\n    return {\r\n      deputados: [],\r\n      carregando: true,\r\n      termoBusca: \"\",\r\n      temporizador: null,\r\n      contadorBusca: 0,\r\n    };\r\n  },\r\n  watch: {\r\n    termoBusca() {\r\n      clearTimeout(this.temporizador);\r\n      this.temporizador = setTimeout(() => {\r\n        this.buscarDeputados();\r\n      }, 400);\r\n    },\r\n  },\r\n  mounted() {\r\n    this.buscarDeputados();\r\n  },\r\n  beforeUnmount() {\r\n    clearTimeout(this.temporizador);\r\n  },\r\n  methods: {\r\n    async buscarDeputados() {\r\n      const numeroDestaBusca = ++this.contadorBusca;\r\n\r\n      try {\r\n        this.carregando = true;\r\n\r\n        let url =\r\n          \"https://dadosabertos.camara.leg.br/api/v2/deputados?ordem=ASC&ordenarPor=nome&itens=100\";\r\n\r\n        const termo = this.termoBusca.trim();\r\n        if (termo) {\r\n          url += `&nome=${encodeURIComponent(termo)}`;\r\n        }\r\n\r\n        const resposta = await fetch(url);\r\n        const json = await resposta.json();\r\n\r\n        if (numeroDestaBusca !== this.contadorBusca) return;\r\n\r\n        this.deputados = json.dados;\r\n      } catch (error) {\r\n        console.error(\"Erro na API de deputados: \", error);\r\n        if (numeroDestaBusca === this.contadorBusca) {\r\n          this.deputados = [];\r\n        }\r\n      } finally {\r\n        if (numeroDestaBusca === this.contadorBusca) {\r\n          this.carregando = false;\r\n        }\r\n      }\r\n    },\r\n    abrirDetalhes(idRecebido) {\r\n      this.$router.push({ name: \"detalhe\", params: { id: idRecebido } });\r\n    },\r\n  },\r\n};\r\n</script>"],"mappings":";AA4CA,OAAOA,YAAW,MAAO,oBAAoB;AAE7C,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MACbC,UAAU,EAAE,IAAI;MAChBC,UAAU,EAAE,EAAE;MACdC,YAAY,EAAE,IAAI;MAClBC,aAAa,EAAE;IACjB,CAAC;EACH,CAAC;EACDC,KAAK,EAAE;IACLH,UAAUA,CAAA,EAAG;MACXI,YAAY,CAAC,IAAI,CAACH,YAAY,CAAC;MAC/B,IAAI,CAACA,YAAW,GAAII,UAAU,CAAC,MAAM;QACnC,IAAI,CAACC,eAAe,CAAC,CAAC;MACxB,CAAC,EAAE,GAAG,CAAC;IACT;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAAC